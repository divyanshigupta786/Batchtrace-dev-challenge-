# ==============================================================================
# BatchTrace Agent — Environment Configuration
# ==============================================================================

# Next.js App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase Database & Auth (PostgreSQL 17-Table Schema)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Open-Weight AI Model (Qwen3-4B via Ollama or Hosted Endpoint)
AI_MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Or hosted inference endpoint:
# HOSTED_INFERENCE_URL=https://api.together.xyz/v1/chat/completions
# HOSTED_INFERENCE_API_KEY=your-api-key
# HOSTED_INFERENCE_MODEL=Qwen/Qwen2.5-3B-Instruct

# Python FastAPI Microservice (Document OCR, Coordinate Parsing, Tabular Engine)
FASTAPI_BACKEND_URL=http://localhost:8000
