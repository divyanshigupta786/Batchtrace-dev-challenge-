{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "batchtrace-backend": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "batchtrace-backend"
      }
    }
  ]
}
